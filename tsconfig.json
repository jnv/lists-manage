{
  "compilerOptions": {
    "noEmit": true,
    "strict": true,
    "types": ["node"],
    "target": "es2024",
    "module": "nodenext",
    "rewriteRelativeImportExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "outDir": "lib",
    "rootDir": "src"
  }
}

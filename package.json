{
  "name": "@jnv/lists-manage",
  "version": "0.6.1",
  "main": "lib/index.js",
  "license": "MIT",
  "type": "module",
  "repository": "github:jnv/lists-manage",
  "bin": {
    "lists-manage": "./bin/run"
  },
  "homepage": "https://github.com/jnv/lists-manage",
  "bugs": "https://github.com/jnv/lists-manage/issues",
  "author": "Jan Vlnas <npm@jan.vlnas.cz> (https://jan.vlnas.cz/)",
  "dependencies": {
    "@cliffy/command": "npm:@jsr/cliffy__command@^1.3.1",
    "@cliffy/prompt": "npm:@jsr/cliffy__prompt@^1.3.1",
    "debug": "^4.4.3",
    "hosted-git-info": "^10.1.1",
    "simple-git": "^4.0.2",
    "tslib": "^2"
  },
  "bundleDependencies": [
    "@cliffy/command",
    "@cliffy/prompt"
  ],
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@types/debug": "^4.1.13",
    "@types/deno": "^2.7.0",
    "@types/hosted-git-info": "^3.0.5",
    "@types/node": "^26.6.6",
    "nock": "^15.0.5",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "node --experimental-strip-types --test './src/**/*.test.ts'",
    "prebuild": "node --input-type=module -e \"import { rm } from 'node:fs/promises'; await rm('lib', { recursive: true, force: true })\"",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build"
  },
  "files": [
    "/bin",
    "/lib"
  ],
  "types": "lib/index.d.ts"
}
